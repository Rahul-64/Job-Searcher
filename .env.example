# Copy to .env and fill in. NEVER commit .env.

# Neon connection string (pooled URL is fine for the API / scraper).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: Neon non-pooled ("direct") URL. Used for migrations when set.
DATABASE_URL_DIRECT=

# Identify the bot to websites; include a way to contact you.
USER_AGENT=jobscraper/0.1 (personal project; contact: you@example.com)

# Politeness and reliability (optional; defaults shown)
# Minimum gap between requests to the same host. A site's robots.txt Crawl-delay
# raises this automatically but never lowers it.
SCRAPE_MIN_INTERVAL=1s
# Consecutive failed runs before a source is auto-disabled (circuit breaker).
SCRAPE_MAX_FAILURES=5

# Which countries to collect jobs for. Default IN (India only). A job located
# only in other countries is not stored; a job whose location cannot be resolved
# is kept. Use a list (IN,SG) or ALL to disable the filter.
TARGET_COUNTRIES=IN

# API / dashboard (optional): connections each serverless instance may hold.
# Keep small: many instances share one Neon connection budget.
API_MAX_CONNS=3

# Later phases
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LLM_API_KEY=
